# OpenAI-compatible API configuration. Never commit your real API key.
AI_API_KEY=replace_with_your_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=replace_with_supported_model
AI_TIMEOUT=60

# API protocol:
# - responses: POST /v1/responses (recommended for newer providers/models)
# - chat_completions: POST /v1/chat/completions (legacy-compatible gateways)
AI_API_STYLE=responses

# Optional request identity. Keep the default unless your provider specifies otherwise.
AI_USER_AGENT=AI-Disk-Assistant/1.2

# AI engineering controls
AI_BATCH_SIZE=12
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF=1
AI_CACHE_PATH=.cache/ai_advice.sqlite3

# strict: no path; balanced: anonymized path; full: original path
AI_PRIVACY_MODE=balanced
